{
  "name": "ants-move",
  "version": "0.0.2",
  "description": "An open-source CLI for collecting and moving data between systems.",
  "homepage": "https://github.com/StephenYgg/ants-move",
  "bugs": {
    "url": "https://github.com/StephenYgg/ants-move/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/StephenYgg/ants-move.git"
  },
  "type": "module",
  "bin": {
    "amv": "dist/index.js",
    "ants": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsup",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "cheerio": "1.2.0",
    "commander": "14.0.1",
    "playwright": "1.59.1",
    "table": "6.9.0",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@types/node": "24.9.0",
    "@vitest/coverage-v8": "4.0.3",
    "tsup": "8.5.0",
    "typescript": "5.9.3",
    "vitest": "4.0.3"
  },
  "keywords": [
    "automation",
    "cli",
    "data-collection",
    "typescript"
  ],
  "author": "Stephen",
  "license": "MIT"
}
